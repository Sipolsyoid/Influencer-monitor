# Copy this file to .env and fill it in. Never commit .env (it holds your email password).

# Instagram account to monitor (without @)
INSTAGRAM_ACCOUNT=editorialcuentosconvalores

# Who gets the daily report (several addresses: separate with commas)
EMAIL_TO=ipb23.d.sipols@vtdt.edu.lv

# The email account that SENDS the report.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=a 16-letter App Password (Google Account > Security > 2-Step Verification > App passwords)
# Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER
EMAIL_FROM=

# Time the daily check runs (24h, used by the schedule scripts)
RUN_TIME=13:00

# Seconds between Instagram page requests. Raise it if Instagram blocks you.
REQUEST_DELAY_SECONDS=1.0

# chrome = use your installed Google Chrome (recommended), chromium = built-in browser
BROWSER=chrome

# HIDE_WINDOW=true runs Chrome off-screen, so no window appears (only a taskbar icon).
# Set it to false to watch the browser while it works.
HIDE_WINDOW=true

# HEADLESS=true uses Chrome's invisible mode instead. Instagram may log it out, so keep false.
HEADLESS=false

# Products to look for in captions. Products separated by ";", other spellings of the same product by "|".
# Example: PRODUCTS=Dragona; Girasol|Gira-sol; Ma ma ma mamut
# Leave empty to switch the product search off. Results: data/product_influencers.json
PRODUCTS=

# How many post captions / follower counts to read per run (spread out so Instagram doesn't block)
CAPTION_CHECKS_PER_RUN=100
FOLLOWER_CHECKS_PER_RUN=50
# Seconds to wait once when Instagram says "too many requests" (429)
RATE_LIMIT_WAIT_SECONDS=180
